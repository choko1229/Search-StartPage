FROM php:8.3-fpm-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends qemu-system-x86 qemu-utils genisoimage curl ca-certificates patchelf && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/isolated-php/lib /opt/vm && cp /usr/local/bin/php /opt/isolated-php/php && ldd /usr/local/bin/php | awk '/=> \//{print $3} $1 ~ /^\//{print $1}' | xargs -I '{}' cp -L '{}' /opt/isolated-php/lib/ && patchelf --set-interpreter /opt/isolated-php/lib/ld-linux-x86-64.so.2 --force-rpath --set-rpath /opt/isolated-php/lib /opt/isolated-php/php
RUN cd /opt/vm && curl --fail --show-error --silent --location --proto '=https' https://cloud-images.ubuntu.com/noble/current/SHA256SUMS -o SHA256SUMS && curl --fail --show-error --silent --location --proto '=https' https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img -o noble-server-cloudimg-amd64.img && awk '$2 == "*noble-server-cloudimg-amd64.img" || $2 == "noble-server-cloudimg-amd64.img"' SHA256SUMS > image.sha256 && test -s image.sha256 && sha256sum -c image.sha256
RUN cd /opt/vm && curl --fail --show-error --silent --location --proto '=https' https://cloud-images.ubuntu.com/noble/current/unpacked/SHA256SUMS -o kernel-SHA256SUMS && for asset in noble-server-cloudimg-amd64-initrd-generic noble-server-cloudimg-amd64-vmlinuz-generic; do curl --fail --show-error --silent --location --proto '=https' "https://cloud-images.ubuntu.com/noble/current/unpacked/$asset" -o "$asset"; awk -v name="$asset" '$2 == name || $2 == "*"name' kernel-SHA256SUMS > "$asset.sha256"; test -s "$asset.sha256"; sha256sum -c "$asset.sha256"; done
